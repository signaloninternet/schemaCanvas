{
  "name": "schemacanvas",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @schemacanvas/web dev",
    "build": "pnpm --filter @schemacanvas/schema-core build && pnpm --filter @schemacanvas/web build",
    "lint": "pnpm --filter @schemacanvas/schema-core lint && pnpm --filter @schemacanvas/web lint",
    "typecheck": "pnpm --filter @schemacanvas/schema-core typecheck && pnpm --filter @schemacanvas/web typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @schemacanvas/schema-core test && pnpm --filter @schemacanvas/web test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.15.18",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
